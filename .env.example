# TypeSafe Jev — https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Azure OpenAI, for embeddings.
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-02-01

# Optional cross-encoder baseline: Voyage rerank-2.5 (https://voyageai.com)
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2.5

# Postgres with pgvector. Neon, or the bundled docker-compose (postgres://jev:jev@127.0.0.1:5434/jevlab)
DATABASE_URL=

# The fi-tes corpus: a local folder of markdown documents plus a CSV of
# question/source pairs. Not shipped with this repository — see README.
CORPUS_SOURCE_DIR=/path/to/corpus/documents
GROUND_TRUTH_CSV=/path/to/corpus/ground-truth.csv

# LLM reranker baselines. Deployment names on the Azure resource above.
AZURE_LLM_DEPLOYMENT=gpt-4.1-mini
AZURE_LLM_API_VERSION=2024-10-21
